# ===================================================================
# Knovis Docker 部署环境变量示例
# ===================================================================
# 使用方法：
#   cp .env.docker.example .env
#   按需修改以下配置，然后 docker-compose up -d
# ===================================================================

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=knovis123

# ===== LLM 配置（系统兜底 key，可选）=====
# DeepSeek API Key：仅当用户未在前端配置自己的 key 时使用（受 FREE_QUOTA_PER_DAY 每日免费额度限制）
# 用户在前端配置自己的 key 后优先使用用户 key，不限流。此变量留空则无系统兜底。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== 免费额度（使用系统兜底 key 时的每日对话次数上限）=====
FREE_QUOTA_PER_DAY=5

# ===== JWT 配置（SSO 形态：只校验 Knovis 签发的 JWT）=====
# JWT_SECRET 必须与 Knovis 服务的 JWT_SECRET 完全一致
# 生成方式：openssl rand -hex 32
JWT_SECRET=please-generate-a-32-byte-random-secret-here
JWT_ISSUER=Knovis
JWT_AUDIENCE=agent-go
# AUTH_MODE: strict(仅 JWT，生产) / dev(JWT 优先 + X-Client-ID 降级，开发)
AUTH_MODE=dev

# ===== AES-256-GCM 主密钥（加密用户 LLM key / Knovis token）=====
# 生成方式：openssl rand -base64 32
MASTER_KEY_V1=please-generate-a-base64-32-byte-key-here

# ===== 子服务鉴权（P0-1，X-API-Key，2026-08-10）=====
# memory-service 与 doc-service 各自独立的 API key，agent-go 调用/转发时携带
# 生成方式：openssl rand -hex 16（两个 key 必须不同；留空 = 子服务跳过鉴权，仅本地开发可留空）
MEMORY_SERVICE_API_KEY=
DOC_SERVICE_API_KEY=

# ===== Knovis 用户服务地址（不入 Docker，通过宿主机访问）=====
# 如果 Knovis 服务也在宿主机跑，保持默认即可
KNOVIS_API_BASE_URL=http://host.docker.internal:8080

# ===== 模型文件路径（宿主机路径，挂载到容器内）=====
# bge-large-zh embedding 模型（memory-service 用）
EMBEDDING_MODEL_PATH=./models/bge-large-zh

# bge-reranker-v2-m3 rerank 模型（doc-service 用，RERANK_ENABLED=true 时需要）
RERANK_MODEL_HOST_PATH=./models/bge-reranker-v2-m3

# ===== Rerank 开关 =====
# true: 启用 rerank（需要 RERANK_MODEL_HOST_PATH 指向有效模型目录）
# false: 不启用 rerank（纯 BM25 + 向量融合）
RERANK_ENABLED=false

# ===== 年报数据路径（宿主机路径，挂载到 doc-service 的 /app/data/uploads）=====
# 15 份上市公司年报 PDF 存放目录（不自动导入，仅挂载供扫描/重新摄入）
UPLOADS_PATH=./data/uploads

# ===================================================================
# 记忆系统：性能与可观测性（检索缓存 / 在线监控 / A-B 实验）
# ===================================================================

# ===== 检索缓存（Redis 两级缓存）=====
CACHE_ENABLED=true
CACHE_TTL_RESULT=60          # L2 结果缓存 TTL（秒）
CACHE_TTL_VECTOR=7200        # L1 向量缓存 TTL（秒）
REDIS_URL=redis://redis:6379/0   # 容器内走 compose 的 redis 服务名

# ===== 在线监控 =====
METRICS_BUFFER_SIZE=1000     # 内存环形缓冲容量
METRICS_MYSQL_AGGREGATE=true # 是否写 MySQL 聚合表

# ===== A/B 实验（生产保持 false）=====
AB_EXPERIMENT_MODE=false

# ===================================================================
# 记忆系统：记忆生命周期（衰减 / 分层 / 合并 / 唤起 / 冻结）
# ===================================================================

# ===== 衰减 =====
DECAY_GRACE_DAYS=30          # 衰减宽限期（天）
DECAY_RATE_WEEKLY=3          # 每周衰减值
DECAY_FLOOR=10               # importance 下限

# ===== 冷热分层 =====
TIER_HOT_IMPORTANCE_MIN=30   # 热记忆 importance 下限
TIER_HOT_ACCESS_DAYS=90      # 热记忆未访问上限（天）
COLD_RECALL_MAX=3            # 单次最多回填冷记忆数

# ===== 合并 =====
MERGE_THRESHOLD=100          # 触发合并的记忆数阈值
MERGE_MAX_CLUSTERS=3         # 单次最多合并簇数
MERGE_MIN_CLUSTER_SIZE=3     # 最小簇大小

# ===================================================================
# 注意事项：
# 1. 首次启动前，请确保模型文件已下载到指定路径：
#    - bge-large-zh: E:\Knovis\models\bge-large-zh（或修改 EMBEDDING_MODEL_PATH）
#    - bge-reranker-v2-m3: E:\models\bge-reranker-v2-m3（或修改 RERANK_MODEL_HOST_PATH）
#
# 2. 若已有 Chroma 向量数据（doc-service 全量年报向量），请复制到：
#    - doc-service: ./data/chroma-doc/
#    - memory-service: ./data/chroma-memory/（如无记忆数据可空）
#    避免重新 embedding（耗时较长）
#
# 3. Knovis 用户服务（8080）需单独启动（不入 Docker）：
#    cd service/userapi && go run user.go
# ===================================================================
