# Knovis 环境变量示例 —— 复制为 .env 后按需修改
# 配置文件 service/userapi/etc/user-api.yaml 中的 ${VAR:default} 会读取环境变量

# ---- 服务 ----
HOST=0.0.0.0
PORT=8080

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=knovis

# ---- Redis(验证码缓存) ----
REDIS_HOST=127.0.0.1:6379
REDIS_PASSWORD=

# ---- JWT(HS256; Agent 端必须使用相同 Secret 校验) ----
JWT_SECRET=knovis-secret-key-change-me
JWT_EXPIRE=86400
JWT_ISSUER=Knovis
JWT_AUDIENCE=agent-go

# ---- SMTP(QQ 邮箱; SMTP_PASSWORD 为邮箱授权码) ----
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-auth-code

# ---- 上传目录 ----
UPLOAD_DIR=./uploads
