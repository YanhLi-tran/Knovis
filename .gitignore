# 工具运行时配置
.reasonix/
reasonix.toml

# 环境变量(含敏感信息, 不入库)
.env

# 上传文件
uploads/

# 构建产物
*.exe
*.out

# ===== Agent 系统(agent-go / doc-service / memory-service / local-agent) =====

# 环境变量(含敏感信息, 不入库)
**/.env

# 构建产物
*.dll
*.so
*.dylib

# 依赖目录
vendor/
node_modules/

# Python 缓存与虚拟环境
__pycache__/
.pytest_cache/
.mypy_cache/
htmlcov/
.coverage
*.pyc

# Agent 运行数据
chroma_data/
data/
uploads/
logs/
*.log
tmp/
dist/
build/
bin/

# Python 子服务运行时数据(chroma 向量库/上传文件, 不入库)
doc-service/data/
memory-service/data/

# 本地 embedding 模型(大文件, 由 EMBEDDING_MODEL 环境变量指定/挂载, 不入库)
memory-service/models/

# 评测脚本本地状态(评测 token, 不入库)
scripts/.eval_token

# 评测脚本本地密钥(含真实 LLM API Key, 不入库)
scripts/_eval_env.ps1
scripts/*_eval_env*

# local-agent 工作目录(agent 文件操作沙箱, 与 local-agent 分离, 不入库)
local-agent/workspace/

# agent 工作区(运行时目录, local-agent 自动创建, 不入库)
agent-workspace/

# 编辑器/系统备份文件
*~
*.swp

# 临时文件
*.tmp
*.swp
*.bak
.tmp_chat.json
.tmp_chat1.json

# ===== deploy/paratera（并行智算云部署）=====
# 环境变量模板含敏感信息，不入库（脚本注释说明: cp .env.paratera .env 后本地编辑）
deploy/paratera/.env.paratera
