# ===== Agent Go Service 环境变量 =====

# 服务配置
AGENT_PORT=8001
AGENT_ENV=development            # development / production

# MySQL 数据库配置（Agent 私有表，可与 agent-go 分机部署；默认本机）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=agent_go

# Session 配置
SESSION_MAX_CONCURRENT=20              # 并发 OTACO 循环上限
SESSION_SOFT_DELETE_RETAIN_DAYS=7      # 软删除后保留天数（超过自动硬删除）
SESSION_SLIDING_WINDOW=100             # 滑动窗口保留的对话轮数
SESSION_TIMEZONE=Asia/Shanghai         # 应用层时区（DB 存 UTC）

# LLM 配置 (兜底用，优先使用请求头 X-LLM-API-Key 传入的用户 key)
LLM_API_KEY=your-deepseek-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# DeepSeek 兼容 OpenAI 协议的接口路径
LLM_CHAT_PATH=/chat/completions

# 腾讯云 WSA 联网搜索配置（web_search 工具使用，缺省时工具不可用但不影响服务启动）
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key

# ===== P2: 记忆系统配置 =====

# Redis 缓存配置（不可用时自动降级直读 MySQL，不阻断服务）
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Python 记忆子服务（embedding + 混合检索）
MEMORY_SERVICE_URL=http://127.0.0.1:8002

# 记忆自动提取：累计多少轮后批量生成 embedding（用户可调）
MEMORY_EMBED_BATCH_ROUNDS=5

# 记忆注入开关（true 注入项目记忆 RAG top-5，false 仅注入全局记忆）
MEMORY_INJECT_PROJECT=true

# soul 是否默认注入（可关闭，仅保留 user + rule_basic 必注）
MEMORY_INJECT_SOUL=true

# ===== P3: 鉴权配置（SSO 形态：只校验 Knovis 签发的 JWT，不自管签发）=====
# AUTH_MODE: strict(仅 JWT，生产模式) / dev(JWT 优先 + X-Client-ID 降级，过渡期默认)
AUTH_MODE=dev
# JWT_SECRET: HS256 密钥，必须与 Knovis 的 JWT_SECRET 完全一致（可用 openssl rand -hex 32 生成）
JWT_SECRET=please-generate-a-32-byte-random-secret-here
# JWT_ISSUER / JWT_AUDIENCE: 与 Knovis 签发 token 的 iss/aud 对齐
JWT_ISSUER=Knovis
JWT_AUDIENCE=agent-go
# MASTER_KEY_V1: AES-256-GCM 主密钥（base64 编码的 32 字节），用于加密用户 LLM key / Knovis token
# 生成方式：openssl rand -base64 32 或 python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# 多版本轮换：MASTER_KEY_V2/V3... + MASTER_KEY_VERSION 指定当前加密版本
# dev 模式未配置时使用随机兜底密钥（重启后旧密文无法解密，仅供开发测试）
MASTER_KEY_V1=please-generate-a-base64-32-byte-key-here

# ===== P4: Knovis 对接配置 =====
# Knovis 用户/动态数据 API 地址（/auth/me 透传 + knovis Skill 读操作复用）
KNOVIS_API_BASE_URL=http://127.0.0.1:8080

# ===== P5: RAG 文档系统配置 =====
# doc-service 地址(PDF 摄入 + RAG 检索子服务,端口 8003)
DOC_SERVICE_URL=http://127.0.0.1:8003
