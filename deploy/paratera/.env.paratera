# =============================================================================
# Knovis @ 并行智算云容器 - 环境变量配置
# 用法: cp deploy/paratera/.env.paratera .env  然后编辑 .env
# 注意: 此文件是项目根级别的 .env，agent-go 和 Knovis 用户服务都会读取
# =============================================================================

# =============================================================================
# 🔴 部署前必改（5 个占位值，不替换会引发安全/功能问题）：
#   1. MEMORY_SERVICE_API_KEY   生成: openssl rand -hex 16
#   2. DOC_SERVICE_API_KEY      生成: openssl rand -hex 16
#      （上面两个 key 必须不同；agent-go 与 Python 子服务通过 X-API-Key 校验，
#        相同则子服务之间可互相冒充，存在安全风险）
#   3. JWT_SECRET               生成: openssl rand -hex 32
#      （必须与 Knovis 侧保持一致，否则 agent-go 校验 JWT 失败、登录不可用）
#   4. MASTER_KEY_V1            生成: openssl rand -base64 32
#      （AES-256-GCM 主密钥，加密用户 LLM key / Knovis token，变更会使已存密钥无法解密）
#   5. LLM_API_KEY              填入真实 DeepSeek API Key（https://platform.deepseek.com/）
#      （不替换则对话功能无 key 可用）
# 生成示例: openssl rand -hex 16 && openssl rand -hex 32 && openssl rand -base64 32
# 替换后再启动: bash deploy/paratera/start.sh
# =============================================================================

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=knovis123
DB_NAME=agent_go

# ===== Redis =====
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===== 子服务地址（本机裸跑，全部 127.0.0.1）=====
MEMORY_SERVICE_URL=http://127.0.0.1:8002
DOC_SERVICE_URL=http://127.0.0.1:8003

# ===== 子服务鉴权 key（P0-1: 服务器上必须设置非空值, agent-go 与 Python 子服务通过 X-API-Key 校验）=====
# 生成方式: openssl rand -hex 16
MEMORY_SERVICE_API_KEY=please-generate-a-random-hex-key
DOC_SERVICE_API_KEY=please-generate-a-random-hex-key

# ===== Knovis 用户服务 =====
# agent-go 访问 Knovis（同机，直接 127.0.0.1）
KNOVIS_API_BASE_URL=http://127.0.0.1:8080
HOST=0.0.0.0
PORT=8080

# ===== LLM 配置（必填，填你的 DeepSeek API Key）=====
# 获取地址: https://platform.deepseek.com/
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 免费额度（使用系统兜底 key 时的每日对话次数上限，用户自带 key 不限流）
FREE_QUOTA_PER_DAY=20

# ===== JWT 配置（HS256，agent-go 和 Knovis 必须使用相同 SECRET）=====
# 生成方式: openssl rand -hex 32
JWT_SECRET=please-generate-a-32-byte-random-secret-here-change-me
JWT_EXPIRE=86400
JWT_ISSUER=Knovis
JWT_AUDIENCE=agent-go
# AUTH_MODE: dev(JWT+X-Client-ID 降级，方便演示) / strict(仅 JWT，生产)
AUTH_MODE=dev

# ===== AES-256-GCM 主密钥（加密用户 LLM key / Knovis token）=====
# 生成方式: openssl rand -base64 32
MASTER_KEY_V1=please-generate-a-base64-32-byte-key-here-change-me

# ===== SMTP 邮箱（可选，演示环境可留空）=====
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
UPLOAD_DIR=/root/shared-nvme/data/uploads

# ===== Embedding 模型（共享存储路径）=====
EMBEDDING_MODEL=/root/shared-nvme/models/bge-large-zh
EMBED_DEVICE=auto
CHROMA_PERSIST_DIR=/root/shared-nvme/data/chroma-memory
EMBED_BATCH_SIZE=64

# ===== RAG 文档服务 =====
DOC_UPLOAD_DIR=/root/shared-nvme/data/uploads
RAG_CHROMA_PERSIST_DIR=/root/shared-nvme/data/chroma-doc
RAG_CHUNK_SIZE=256
RAG_CHUNK_OVERLAP=26
RERANK_ENABLED=false
RERANK_MODEL_PATH=/root/shared-nvme/models/bge-reranker-v2-m3

# ===== 记忆服务参数 =====
BM25_WEIGHT=0.3
RAG_WEIGHT=0.7
RECALL_TOP_N=20
FINAL_TOP_K=5

# ===== 检索缓存(Redis 两级缓存, 默认开启)=====
CACHE_ENABLED=true
CACHE_TTL_RESULT=60
CACHE_TTL_VECTOR=7200
REDIS_URL=redis://127.0.0.1:6379/0

# ===== 在线监控 =====
METRICS_BUFFER_SIZE=1000
METRICS_MYSQL_AGGREGATE=true
AB_EXPERIMENT_MODE=false

# ===== 记忆生命周期(衰减/分层/合并)=====
DECAY_GRACE_DAYS=30
DECAY_RATE_WEEKLY=3
DECAY_FLOOR=10
TIER_HOT_IMPORTANCE_MIN=30
TIER_HOT_ACCESS_DAYS=90
COLD_RECALL_MAX=3
MERGE_THRESHOLD=100
MERGE_MAX_CLUSTERS=3
MERGE_MIN_CLUSTER_SIZE=3
