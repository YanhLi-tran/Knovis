# ===== doc-service 配置(端口 8003)=====

# 服务端口
DOC_SERVICE_PORT=8003

# memory-service 地址(复用 /embed 获取向量,不重复加载 bge-large-zh)
MEMORY_SERVICE_URL=http://127.0.0.1:8002

# Chroma 持久化目录(doc-service 独立目录,自主 upsert,与 memory-service 隔离避免并发)
# collection 名 doc_global(全局共享),metadata 含 document_id 支持 doc_ids 过滤
CHROMA_PERSIST_DIR=./data/chroma

# 文档上传存储目录
DOC_UPLOAD_DIR=./data/uploads

# MySQL(与 Go 服务、memory-service 共用同一个库)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=agent_go

# 分块策略
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=64

# 检索参数
RAG_BM25_WEIGHT=0.3
RAG_RAG_WEIGHT=0.7
RAG_RECALL_TOP_N=20
RAG_FINAL_TOP_K=5
RAG_SECTION_MAX_LEN=2000

# Rerank(预留,首版不启用)
RERANK_ENABLED=false
RERANK_MODEL_PATH=
# 启用时填本地 rerank 模型路径,如 E:\models\bge-reranker-v2-m3
