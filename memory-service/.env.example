# ===== Python 记忆子服务配置 =====

# 服务端口
MEMORY_SERVICE_PORT=8002

# Embedding 模型（HuggingFace 名称或本地路径）
# 方式 1：用项目内自带的本地路径（推荐，无需联网下载）
EMBEDDING_MODEL=./models/bge-large-zh
# 方式 2：用 HuggingFace 名称（首次启动自动下载到 ~/.cache/huggingface，约 1.5GB）
# EMBEDDING_MODEL=BAAI/bge-large-zh

# Chroma 向量库持久化目录（嵌入式单实例）
CHROMA_PERSIST_DIR=./data/chroma

# MySQL 配置（用于 BM25 全文检索，与 Go 服务共用同一个库）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=agent_go

# 混合检索权重（BM25 + RAG），默认 3:7
BM25_WEIGHT=0.3
RAG_WEIGHT=0.7

# 单次批量 embedding 上限（防 OOM）
EMBED_BATCH_SIZE=32

# 召回数量（每路 top-N，融合后取 top-5）
RECALL_TOP_N=10
FINAL_TOP_K=5
